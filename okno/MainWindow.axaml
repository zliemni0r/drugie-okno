<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="pierwsza zmiana"
        Width="400" Height="300"
        WindowDecorations="None"
        Background="Gray">

    <Window.Styles>
        <Style Selector="TextBlock.rainbow">
            <Style.Animations>
                <!-- Animacja kolorów (tęcza) -->
                <Animation Duration="0:0:6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Foreground" Value="Red"/>
                    </KeyFrame>
                    <KeyFrame Cue="17%">
                        <Setter Property="Foreground" Value="Orange"/>
                    </KeyFrame>
                    <KeyFrame Cue="33%">
                        <Setter Property="Foreground" Value="Yellow"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Foreground" Value="Green"/>
                    </KeyFrame>
                    <KeyFrame Cue="67%">
                        <Setter Property="Foreground" Value="DeepSkyBlue"/>
                    </KeyFrame>
                    <KeyFrame Cue="83%">
                        <Setter Property="Foreground" Value="MediumPurple"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Foreground" Value="Red"/>
                    </KeyFrame>
                </Animation>

                <!-- Animacja powiększania i zmniejszania -->
                <Animation Duration="0:0:2" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="FontSize" Value="20"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="FontSize" Value="36"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <TextBlock Classes="rainbow" Text="inny tekst" Background="Black" FontWeight="Light" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Window>
